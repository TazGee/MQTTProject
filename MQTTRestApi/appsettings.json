{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=MQTTDatabase;User=root;Password=rootpassword;"
  },
  "Redis": {
    "ConnectionString": "localhost:6380"
  },
  "MqttBroker": {
    "Host": "localhost",
    "Port": 1883
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "MQTTRestApi",
    "Audience": "MQTTRestApiClients",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*",
  "PublishRegex" : "^[^/#+\\s]+(?:/[^/#+\\s]+)*$",
  "SubscribeRegex" : "^(?:#|(?:[^/#+\\s]+|\\+)(?:/(?:[^/#+\\s]+|\\+))*(?:/#)?)$",
  "ReconnectTimer" : "3"
}
