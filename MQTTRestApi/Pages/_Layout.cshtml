<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <title>RestAPI Backend Test</title>
    <link rel="stylesheet" href="style.css" />
</head>
<body>
<header>
    <div class="row">
        <img class="logo" src="assets/logo.png" alt="logoSajta"/>
        <h1>RestAPI</h1>
    </div>
    <div class="row">
        <a asp-page="./Index"><button class="headerButton">Pocetna</button></a>
        @if (User.Identity?.IsAuthenticated == true) { <a asp-page="./Index"><button class="headerButton">Pretplate</button></a> }
        @if (User.Identity?.IsAuthenticated == true) { <a asp-page="./Index"><button class="headerButton">Poruke</button></a> }
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin")) { <a asp-page="./Index"><button class="headerButton">Admin</button></a> }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="./Logout"><button class="headerButton">Logout</button></a>
        }
        else
        {
            <a asp-page="./Login"><button class="headerButton">Login</button></a>
        }
    </div>
</header>
<main>@RenderBody()</main>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>