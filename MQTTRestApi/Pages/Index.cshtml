            <h2 id="-primeri-curl-komandi-">⌨️ - <strong>Primeri curl komandi</strong> - ⌨️</h2>
            <ul>
            <li>Subscribe<pre><code class="lang-bash">curl -X <span class="hljs-string">'POST'</span> <span class="hljs-string">\</span>
            <span class="hljs-string">'http://localhost:5000/api/mqtt/subscribe'</span> <span class="hljs-string">\</span>
            -H <span class="hljs-string">'accept: */*'</span> <span class="hljs-string">\</span>
            -H <span class="hljs-string">'Content-Type: application/json'</span> <span class="hljs-string">\</span>
            -d <span class="hljs-string">'{
            "topic": "kuca/kupatilo/temperatura"
            }'</span>
            </code></pre>
            </li>
            <li>Publish<pre><code class="lang-bash">curl -X <span class="hljs-symbol">'POST</span>' \
            <span class="hljs-symbol">'http</span>://localhost:<span class="hljs-number">5000</span>/api/mqtt/publish' \
            -H <span class="hljs-symbol">'accept</span>: */*' \
            -H <span class="hljs-symbol">'Content</span>-<span class="hljs-keyword">Type</span>: application/json' \
            -d '{
            <span class="hljs-string">"topic"</span>: <span class="hljs-string">"kuca/kupatilo/temperatura"</span>,
            <span class="hljs-string">"payload"</span>: <span class="hljs-string">"22"</span>,
            <span class="hljs-string">"qoS"</span>: <span class="hljs-number">0</span>
            }'
            </code></pre>
            </li>
            <li>Lista poruka<pre><code class="lang-bash">curl -X <span class="hljs-string">'GET'</span> <span class="hljs-string">\</span>
            <span class="hljs-string">'http://localhost:5000/api/mqtt/messages'</span> <span class="hljs-string">\</span>
            -H <span class="hljs-string">'accept: */*'</span>
            </code></pre>
            </li>
            <li>Stats za sve topice<pre><code class="lang-bash">curl -X <span class="hljs-string">'GET'</span> <span class="hljs-string">\</span>
            <span class="hljs-string">'http://localhost:5000/api/mqtt/stats'</span> <span class="hljs-string">\</span>
            -H <span class="hljs-string">'accept: */*'</span>
            </code></pre>
            </li>
            <li>Stats za jedan topic<pre><code class="lang-bash">curl -X <span class="hljs-string">'GET'</span> <span class="hljs-string">\</span>
            <span class="hljs-string">'http://localhost:5000/api/mqtt/stats/kuca%2Fsoba%2Ftemperatura'</span> <span class="hljs-string">\</span>
            -H <span class="hljs-string">'accept: */*'</span>
            </code></pre>
            </li>
            </ul>
